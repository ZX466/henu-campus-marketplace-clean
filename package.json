{
  "name": "campuscart",
  "version": "1.0.0",
  "description": "CampusCart — Next-Gen Student Marketplace (Genesis-Inspired)",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"FRONTEND,BACKEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/start-backend.cjs",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "install:frontend": "node scripts/install-frontend.cjs",
    "setup:backend": "node scripts/setup-backend.cjs",
    "setup": "npm install && npm run install:frontend && npm run setup:backend",
    "check:health": "node scripts/check-health.cjs",
    "db:start": "node scripts/mongo-docker.cjs start",
    "db:stop": "node scripts/mongo-docker.cjs stop",
    "db:status": "node scripts/mongo-docker.cjs status"
  },
  "keywords": [
    "campuscart",
    "marketplace",
    "college",
    "vite",
    "react",
    "student-commerce"
  ],
  "author": "The nightHawks",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
