# =============================================================
# 河大同享 · 后端环境变量样例
# 复制一份到同一目录并改名为 .env，再按需修改：
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密码和密钥。
# =============================================================

# 运行环境：development（本地开发）或 production（线上部署）
# production 下会关闭 /api/v1/products/seed 等开发用接口
APP_ENV=development

# ---- MongoDB（默认端口 27017）----
# 本地或 Docker 启动的 MongoDB 用下面这一行。
# directConnection=true 让驱动直连本机，副本集模式下也不会去找容器主机名。
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# 使用 MongoDB Atlas 时换成控制台给的连接串，例如：
# MONGO_URI=mongodb+srv://<用户名>:<密码>@<集群地址>/?retryWrites=true&w=majority
MONGO_DB_NAME=campuscart_db

# ---- 登录签名密钥 ----
# 必须换成自己的随机长字符串，生成方法：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ---- 前端地址（用于 CORS 白名单）----
# 前端 Vite 固定在 3334 端口，后端固定在 8000 端口
FRONTEND_URL=http://localhost:3334
